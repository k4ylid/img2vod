{
  "name": "framevod",
  "version": "0.1.0",
  "private": true,
  "description": "FrameVOD - turn still images into motion videos",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron .",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "pixi.js": "8.21.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.5",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "ffprobe-static": "3.1.0",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "5.0.2"
  }
}
